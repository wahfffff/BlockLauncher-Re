# Rust
/core/target/
**/*.rs.bk
Cargo.lock.orig

# Android / Gradle
/android/.gradle/
/android/build/
/android/app/build/
/android/.kotlin/
/android/local.properties

# Built by `cargo ndk` in CI and copied into the APK; never committed, because a
# stale .so in the tree is indistinguishable from a fresh one.
/android/app/src/main/jniLibs/

*.apk
*.aab
*.keystore
*.jks

# The debug signing key CI creates and caches. Never committed: it is the
# identity that lets one build install over the previous one, and a key in the
# repository would be a key anyone could sign with.
/android/.keystore/

# Host scratch
/scratch/
